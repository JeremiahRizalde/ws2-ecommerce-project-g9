<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Pixel Stop Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/adminstyle.css">

</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/admin/products">Manage Products</a></li>
                <li><a href="/users/dashboard">Dashboard</a></li>
                <li><a href="/users/logout">Logout</a></li>
            </ul>
        </div>
    </nav>

    <!-- Main Content -->
    <main>
        <section class="hero" style="background: linear-gradient(to bottom, var(--pastel-purple), var(--minecraft-green));">
            <h1>Edit Product</h1>
            <p>Update the product details below</p>
        </section>

        <div class="form-container">
            <!-- Error Messages -->
            <% if (errors && errors.length > 0) { %>
                <div class="error-list">
                    <p style="font-weight: bold; margin-bottom: 0.5rem; font-size: 0.75rem;">⚠️ Please fix the following errors:</p>
                    <ul>
                        <% errors.forEach(function(err) { %>
                            <li><%= err %></li>
                        <% }) %>
                    </ul>
                </div>
            <% } %>

            <div class="product-form">
                <h2 style="margin-bottom: 1.5rem; font-size: 1rem;">Product Information</h2>
                
                <form action="/admin/products/edit/<%= productId %>" method="POST">
                    <div class="form-group">
                        <label for="name">Product Name *</label>
                        <input
                            type="text"
                            id="name"
                            name="name"
                            value="<%= formData && formData.name ? formData.name : (product.title || product.name) %>"
                            placeholder="Enter product name (min 2 characters)"
                        />
                    </div>

                    <div class="form-group">
                        <label for="description">Description *</label>
                        <textarea
                            id="description"
                            name="description"
                            placeholder="Enter product description (min 5 characters)"
                        ><%= formData && formData.description ? formData.description : product.description %></textarea>
                    </div>

                    <div class="form-group">
                        <label for="price">Price (PHP) *</label>
                        <input
                            type="text"
                            id="price"
                            name="price"
                            value="<%= formData && formData.price ? formData.price : product.price %>"
                            placeholder="0.00"
                        />
                    </div>

                    <div class="form-group">
                        <label for="category">Category/Genre *</label>
                        <% 
                        const currentCategory = (formData && formData.category) || product.genre || product.category || '';
                        %>
                        <select id="category" name="category">
                            <option value="">Select a category...</option>
                            <option value="minecraft" <%= currentCategory === 'minecraft' ? 'selected' : '' %>>Minecraft</option>
                            <option value="stardewvalley" <%= currentCategory === 'stardewvalley' ? 'selected' : '' %>>Stardew Valley</option>
                            <option value="terraria" <%= currentCategory === 'terraria' ? 'selected' : '' %>>Terraria</option>
                            <option value="pokemon" <%= currentCategory === 'pokemon' ? 'selected' : '' %>>Pokemon</option>
                            <option value="harvestmoon" <%= currentCategory === 'harvestmoon' ? 'selected' : '' %>>Harvest Moon</option>
                            <option value="other" <%= currentCategory === 'other' ? 'selected' : '' %>>Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="imageUrl">Image URL</label>
                        <input
                            type="text"
                            id="imageUrl"
                            name="imageUrl"
                            value="<%= formData && formData.imageUrl ? formData.imageUrl : (product.imageUrl || '') %>"
                            placeholder="https://example.com/image.jpg"
                        />
                    </div>

                    <div class="button-group">
                        <button type="submit" class="pixel-btn">Update Product</button>
                        <a href="/admin/products" class="pixel-btn" style="background: white; color: var(--pixel-black); text-decoration: none; display: inline-block;">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <%- include('/partials/footer.ejs') %>
</body>
</html>
