<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management - Pixel Stop Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-products-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }
        
        .add-product-form {
            background: white;
            border: 4px solid var(--pixel-black);
            padding: 2rem;
            margin-bottom: 2rem;
        }
        
        .add-product-form h2 {
            margin-bottom: 1.5rem;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }
        
        .form-group {
            margin-bottom: 1rem;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.75rem;
        }
        
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid var(--pixel-black);
            font-family: 'Press Start 2P', cursive;
            font-size: 0.65rem;
        }
        
        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }
        
        .products-table {
            background: white;
            border: 4px solid var(--pixel-black);
            padding: 1rem;
        }
        
        .products-table table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .products-table th,
        .products-table td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 2px solid var(--pixel-black);
            font-size: 0.65rem;
        }
        
        .products-table th {
            background-color: var(--pastel-blue);
        }
        
        .product-img-preview {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border: 2px solid var(--pixel-black);
        }
        
        .action-buttons {
            display: flex;
            gap: 0.5rem;
        }
        
        .btn-small {
            padding: 0.4rem 0.8rem;
            font-size: 0.6rem;
        }
        
        .edit-form {
            background: #fffacd;
            padding: 1rem;
            border: 2px solid var(--pixel-black);
            margin-top: 0.5rem;
        }
        
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
            
            .products-table {
                overflow-x: auto;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/admin/products">Manage Products</a></li>
                <li><a href="/users/dashboard">Dashboard</a></li>
                <li><a href="/users/logout">Logout</a></li>
            </ul>
        </div>
    </nav>

    <!-- Flash Messages -->
    <% if (typeof message !== 'undefined' && message && message.length > 0) { %>
        <div class="container">
            <div class="alert alert-success">
                <%= message %>
            </div>
        </div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="container">
            <div class="alert alert-danger">
                <%= error %>
            </div>
        </div>
    <% } %>

    <!-- Main Content -->
    <main>
        <section class="hero" style="background: linear-gradient(to bottom, var(--pastel-purple), var(--minecraft-green));">
            <h1>Product Management</h1>
            <p>Add, edit, or remove products from your catalog</p>
        </section>

        <div class="admin-products-container">
            <!-- Add Product Form -->
            <div class="add-product-form">
                <h2>Add New Product</h2>
                <form action="/admin/products/add" method="POST">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="title">Product Title *</label>
                            <input type="text" id="title" name="title" required>
                        </div>
                        <div class="form-group">
                            <label for="price">Price (PHP) *</label>
                            <input type="number" id="price" name="price" step="0.01" min="0" required>
                        </div>
                    </div>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label for="genre">Genre/Game *</label>
                            <select id="genre" name="genre" required>
                                <option value="">Select a game...</option>
                                <option value="minecraft">Minecraft</option>
                                <option value="stardewvalley">Stardew Valley</option>
                                <option value="terraria">Terraria</option>
                                <option value="pokemon">Pokemon</option>
                                <option value="harvestmoon">Harvest Moon</option>
                                <option value="other">Other</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="imageUrl">Image URL *</label>
                            <input type="url" id="imageUrl" name="imageUrl" required placeholder="https://example.com/image.jpg">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="description">Description *</label>
                        <textarea id="description" name="description" required></textarea>
                    </div>
                    
                    <button type="submit" class="pixel-btn">Add Product</button>
                </form>
            </div>

            <!-- Products List -->
            <div class="products-table">
                <h2 style="margin-bottom: 1.5rem;">Current Products (<%= products.length %>)</h2>
                
                <% if (products.length === 0) { %>
                    <p style="text-align: center; padding: 2rem; color: #666;">No products yet. Add your first product above!</p>
                <% } else { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Title</th>
                                <th>Genre</th>
                                <th>Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach((product, index) => { %>
                                <tr>
                                    <td>
                                        <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="product-img-preview" onerror="this.src='/images/placeholder.png'">
                                    </td>
                                    <td><%= product.title %></td>
                                    <td><%= product.genre %></td>
                                    <td>₱<%= product.price.toFixed(2) %></td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="pixel-btn btn-small" onclick="toggleEditForm('<%= product._id %>')">Edit</button>
                                            <form action="/admin/products/delete/<%= product._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this product?')">
                                                <button type="submit" class="pixel-btn btn-small" style="background-color: #ff4444;">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                                <tr id="edit-form-<%= product._id %>" style="display: none;">
                                    <td colspan="5">
                                        <div class="edit-form">
                                            <h3 style="margin-bottom: 1rem;">Edit Product</h3>
                                            <form action="/admin/products/edit/<%= product._id %>" method="POST">
                                                <div class="form-row">
                                                    <div class="form-group">
                                                        <label>Product Title</label>
                                                        <input type="text" name="title" value="<%= product.title %>" required>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Price (PHP)</label>
                                                        <input type="number" name="price" value="<%= product.price %>" step="0.01" min="0" required>
                                                    </div>
                                                </div>
                                                <div class="form-row">
                                                    <div class="form-group">
                                                        <label>Genre/Game</label>
                                                        <select name="genre" required>
                                                            <option value="minecraft" <%= product.genre === 'minecraft' ? 'selected' : '' %>>Minecraft</option>
                                                            <option value="stardewvalley" <%= product.genre === 'stardewvalley' ? 'selected' : '' %>>Stardew Valley</option>
                                                            <option value="terraria" <%= product.genre === 'terraria' ? 'selected' : '' %>>Terraria</option>
                                                            <option value="pokemon" <%= product.genre === 'pokemon' ? 'selected' : '' %>>Pokemon</option>
                                                            <option value="harvestmoon" <%= product.genre === 'harvestmoon' ? 'selected' : '' %>>Harvest Moon</option>
                                                            <option value="other" <%= product.genre === 'other' ? 'selected' : '' %>>Other</option>
                                                        </select>
                                                    </div>
                                                    <div class="form-group">
                                                        <label>Image URL</label>
                                                        <input type="url" name="imageUrl" value="<%= product.imageUrl %>" required>
                                                    </div>
                                                </div>
                                                <div class="form-group">
                                                    <label>Description</label>
                                                    <textarea name="description" required><%= product.description %></textarea>
                                                </div>
                                                <div style="display: flex; gap: 0.5rem;">
                                                    <button type="submit" class="pixel-btn btn-small">Save Changes</button>
                                                    <button type="button" class="pixel-btn btn-small" onclick="toggleEditForm('<%= product._id %>')">Cancel</button>
                                                </div>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('/partials/footer.ejs') %>

    <script>
        function toggleEditForm(productId) {
            const editRow = document.getElementById(`edit-form-${productId}`);
            if (editRow.style.display === 'none') {
                editRow.style.display = 'table-row';
            } else {
                editRow.style.display = 'none';
            }
        }
    </script>
</body>
</html>
