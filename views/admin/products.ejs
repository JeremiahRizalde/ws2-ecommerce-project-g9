<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Management - Pixel Stop Admin</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .admin-products-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 2rem 1rem;
        }
        
        .add-product-form {
            background: white;
            border: 4px solid var(--pixel-black);
            padding: 2rem;
            margin-bottom: 2rem;
        }
        
        .add-product-form h2 {
            margin-bottom: 1.5rem;
        }
        
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
            margin-bottom: 1rem;
        }
        
        .form-group {
            margin-bottom: 1rem;
        }
        
        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.75rem;
        }
        
        .form-group input,
        .form-group textarea,
        .form-group select {
            width: 100%;
            padding: 0.75rem;
            border: 2px solid var(--pixel-black);
            font-family: 'Press Start 2P', cursive;
            font-size: 0.65rem;
        }
        
        .form-group textarea {
            min-height: 100px;
            resize: vertical;
        }
        
        .products-table {
            background: white;
            border: 4px solid var(--pixel-black);
            padding: 1rem;
        }
        
        .products-table table {
            width: 100%;
            border-collapse: collapse;
        }
        
        .products-table th,
        .products-table td {
            padding: 0.75rem;
            text-align: left;
            border-bottom: 2px solid var(--pixel-black);
            font-size: 0.65rem;
        }
        
        .products-table th {
            background-color: var(--pastel-blue);
        }
        
        .product-img-preview {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border: 2px solid var(--pixel-black);
        }
        
        .action-buttons {
            display: flex;
            gap: 0.5rem;
        }
        
        .btn-small {
            padding: 0.4rem 0.8rem;
            font-size: 0.6rem;
        }
        
        .edit-form {
            background: #fffacd;
            padding: 1rem;
            border: 2px solid var(--pixel-black);
            margin-top: 0.5rem;
        }
        
        @media (max-width: 768px) {
            .form-row {
                grid-template-columns: 1fr;
            }
            
            .products-table {
                overflow-x: auto;
            }
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/admin/products">Manage Products</a></li>
                <li><a href="/users/dashboard">Dashboard</a></li>
                <li><a href="/users/logout">Logout</a></li>
            </ul>
        </div>
    </nav>


    <!-- Main Content -->
    <main>
        <section class="hero" style="background: linear-gradient(to bottom, var(--pastel-purple), var(--minecraft-green));">
            <h1>Product Management</h1>
            <p>Add, edit, or remove products from your catalog</p>
        </section>

        <div class="admin-products-container">
            <!-- Search and Filter Form -->
            <div class="add-product-form" style="margin-bottom: 1.5rem;">
                <h2>Search Products</h2>
                <form action="/admin/products" method="GET" style="margin-top: 1rem;">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="search">Search by Name</label>
                            <input type="text" id="search" name="search" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" placeholder="Enter product name...">
                        </div>
                        <div class="form-group">
                            <label for="category">Filter by Category</label>
                            <select id="category" name="category">
                                <option value="">All Categories</option>
                                <option value="minecraft" <%= typeof categoryFilter !== 'undefined' && categoryFilter === 'minecraft' ? 'selected' : '' %>>Minecraft</option>
                                <option value="stardewvalley" <%= typeof categoryFilter !== 'undefined' && categoryFilter === 'stardewvalley' ? 'selected' : '' %>>Stardew Valley</option>
                                <option value="terraria" <%= typeof categoryFilter !== 'undefined' && categoryFilter === 'terraria' ? 'selected' : '' %>>Terraria</option>
                                <option value="pokemon" <%= typeof categoryFilter !== 'undefined' && categoryFilter === 'pokemon' ? 'selected' : '' %>>Pokemon</option>
                                <option value="harvestmoon" <%= typeof categoryFilter !== 'undefined' && categoryFilter === 'harvestmoon' ? 'selected' : '' %>>Harvest Moon</option>
                                <option value="other" <%= typeof categoryFilter !== 'undefined' && categoryFilter === 'other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>
                    </div>
                    <div style="display: flex; gap: 0.5rem;">
                        <button type="submit" class="pixel-btn">Search</button>
                        <a href="/admin/products" class="pixel-btn" style="background: white; color: var(--pixel-black); text-decoration: none;">Clear</a>
                    </div>
                </form>
            </div>

            <!-- Add Product Button -->
            <div class="add-product-form">
                <h2>Product Management</h2>
                <p style="font-size: 0.65rem; margin: 1rem 0;">Manage your product catalog below. Click "Add New Product" to create a product.</p>
                <a href="/admin/products/new" class="pixel-btn">Add New Product</a>
            </div>

            <!-- Message Display -->
            <% if (message) { %>
                <div class="container">
                    <div
                        style="
                            padding: 10px;
                            margin-bottom: 15px;
                            border: 1px solid <%= message.type === 'success' ? 'green' : 'red' %>;
                            background-color: <%= message.type === 'success' ? '#e6ffed' : '#ffe6e6' %>;
                            color: <%= message.type === 'success' ? 'green' : 'red' %>;
                            font-size: 0.75rem;
                        "
                    >
                        <%= message.text %>
                    </div>
                </div>
            <% } %>
            
            <!-- Products List -->
            <div class="products-table">
                <h2 style="margin-bottom: 1.5rem;">Current Products (<%= products.length %>)</h2>
                
                <% if (products.length === 0) { %>
                    <p style="text-align: center; padding: 2rem; color: #666;">No products yet. Add your first product above!</p>
                <% } else { %>
                    <table>
                        <thead>
                            <tr>
                                <th>Image</th>
                                <th>Title</th>
                                <th>Genre</th>
                                <th>Price</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% products.forEach((product, index) => { %>
                                <tr>
                                    <td>
                                        <img src="<%= product.imageUrl %>" alt="<%= product.title %>" class="product-img-preview" onerror="this.src='/images/placeholder.png'">
                                    </td>
                                    <td><%= product.title %></td>
                                    <td><%= product.genre %></td>
                                    <td>₱<%= product.price.toFixed(2) %></td>
                                    <td>
                                        <div class="action-buttons">
                                            <a href="/admin/products/edit/<%= product.productId || product._id %>" class="pixel-btn btn-small">Edit</a>
                                            <form action="/admin/products/delete/<%= product._id %>" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.')">
                                                <button type="submit" class="pixel-btn btn-small" style="background-color: #ff4444;">Delete</button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <%- include('/partials/footer.ejs') %>
</body>
</html>
