<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="/css/adminstyle.css">
    <title><%= title %></title>
    <meta charset="UTF-8" />
    <style>
        /* Print-specific styles */
        @media print {
            /* Hide elements that shouldn't be printed */
            .no-print {
                display: none !important;
            }
            
            /* Page setup */
            @page {
                size: A4;
                margin: 15mm;
            }
            
            body {
                margin: 0;
                padding: 0;
                font-size: 10pt;
                line-height: 1.3;
            }
            
            /* Container adjustments */
            .admin-reports-container {
                max-width: 100%;
                padding: 0;
                margin: 0;
            }
            
            .report-section {
                padding: 10px;
                margin-bottom: 15px;
                border: 2px solid #000;
                page-break-inside: avoid;
            }
            
            /* Headings */
            .hero {
                background: none !important;
                padding: 10px 0;
                page-break-after: avoid;
            }
            
            .hero h1 {
                font-size: 18pt;
                margin: 0 0 5px 0;
                color: #000;
            }
            
            .hero p {
                font-size: 10pt;
                margin: 0;
                color: #000;
            }
            
            h2 {
                font-size: 14pt;
                margin: 0 0 10px 0;
                page-break-after: avoid;
            }
            
            .summary-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
                margin-top: 10px;
                page-break-inside: avoid;
            }
            
            .summary-card {
                border: 2px solid #000;
                padding: 10px;
                text-align: center;
                background: #f5f5f5 !important;
            }
            
            .summary-card h3 {
                font-size: 9pt;
                margin-bottom: 5px;
            }
            
            .summary-card .value {
                font-size: 16pt;
                margin-top: 5px;
            }
            
            .data-table {
                width: 100%;
                border-collapse: collapse;
                page-break-inside: avoid;
                font-size: 9pt;
            }
            
            .data-table th,
            .data-table td {
                border: 1px solid #000;
                padding: 6px;
                text-align: left;
            }
            
            .data-table th {
                background-color: #e0e0e0 !important;
                font-weight: bold;
            }
            
            /* Chart container */
            .chart-container {
                height: 250px !important;
                width: 100%;
                page-break-inside: avoid;
                page-break-before: auto;
            }
            
            #salesChart {
                max-height: 250px !important;
                width: 100% !important;
            }
            
            /* Force chart to render properly */
            canvas {
                max-width: 100% !important;
                height: auto !important;
            }
            
            /* Ensure sections don't break across pages */
            .report-section {
                page-break-inside: avoid;
            }
            
            .no-data-message {
                text-align: center;
                padding: 15px;
                font-size: 10pt;
            }
        }
        
        /* Screen styles */
        @media screen {
            #salesChart {
                max-height: 350px;
            }
        }
    </style>

</head>
<body>
    <section class="no-print">
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/admin/dashboard">Dashboard</a></li>
                <li><a href="/admin/products">Manage Products</a></li>
                <li><a href="/admin/orders">Manage Orders</a></li>
                <li><a href="/admin/reports/sales">Sales Reports</a></li>
                <li><a href="/users/logout">Logout</a></li>
            </ul>
        </div>
    </nav>
    </section>
    <!-- Main Content -->
    <main>
        <section class="hero" style="background: linear-gradient(to bottom, var(--pastel-purple), var(--minecraft-green));">
            <h1>Sales Overview</h1>
            <p>Analyze your sales performance with detailed reports and charts</p>
        </section>

        <section class="no-print">
        <div class="admin-reports-container">
            <div class="report-section">

                <h2>Navigate</h2>
                <p>
                    <a href="/admin/products" class="pixel-btn">Back to Products</a>
                    <a href="/admin/orders" class="pixel-btn">View Orders</a>
                </p>
                <section class="no-print" style="margin-bottom: 15px;">
                <h2>Report Actions</h2>
                <!-- Daily sales XLSX export -->
                <a href="/admin/reports/sales/export/daily?startDate=<%= filters.startDate%>&endDate=<%= filters.endDate %>&status=<%= filters.status %>" class="pixel-btn" style="background: white; color: var(--pixel-black); text-decoration: none;">
                Download Daily Sales (XLSX)</a>

                <!-- Detailed orders XLSX export (you will implement later) -->
                <a href="/admin/reports/sales/export/orders?startDate=<%= filters.startDate%>&endDate=<%= filters.endDate %>&status=<%= filters.status %>"class="pixel-btn" style="background: white; color: var(--pixel-black); text-decoration: none;">Download Detailed Orders (XLSX)</a>
                <p>
                    
                <!-- Print / Save as PDF -->
                <button type="button" onclick="window.print();" class="pixel-btn" style="background: rgb(219, 219, 219); color: var(--pixel-black); text-decoration: none;">
                Print / Save as PDF
                </button>
                </p>
            </section>
            </div>
        </div>
        </section>

        <section class="no-print">
        <div class="admin-reports-container">
            <!-- Filters Section -->
            <div class="report-section">
                <h2>Filters</h2>
                <form action="/admin/reports/sales" method="GET" class="filters-form">
                    <div class="form-group">
                        <label for="startDate">Start date:</label>
                        <input
                            type="date"
                            id="startDate"
                            name="startDate"
                            value="<%= filters.startDate %>"
                        />
                    </div>
                    <div class="form-group">
                        <label for="endDate">End date:</label>
                        <input
                            type="date"
                            id="endDate"
                            name="endDate"
                            value="<%= filters.endDate %>"
                        />
                    </div>
                    <div class="form-group">
                        <label for="status">Order status:</label>
                        <select id="status" name="status">
                            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>
                                All statuses
                            </option>
                            <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>
                                Completed only
                            </option>
                            <option value="to_pay" <%= filters.status === 'to_pay' ? 'selected' : '' %>>
                                To Pay
                            </option>
                            <option value="to_ship" <%= filters.status === 'to_ship' ? 'selected' : '' %>>
                                To Ship
                            </option>
                            <option value="to_receive" <%= filters.status === 'to_receive' ? 'selected' : '' %>>
                                To Receive
                            </option>
                            <option value="refund" <%= filters.status === 'refund' ? 'selected' : '' %>>
                                Return / Refund
                            </option>
                            <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>
                                Cancelled
                            </option>
                        </select>
                    </div>
                    <div class="filter-buttons" style="grid-column: 1 / -1;">
                        <button type="submit" class="pixel-btn">Apply filters</button>
                        <a href="/admin/reports/sales" class="pixel-btn" style="background: white; color: var(--pixel-black); text-decoration: none;">Clear</a>
                    </div>
                </form>
            </div>
        </div>
        </section>

        <div class="admin-reports-container">
            <!-- Summary Section -->
            <div class="report-section">
                <h2>Summary</h2>
                <% if (dailySales.length === 0) { %>
                    <p class="no-data-message">No sales data found for the selected filters.</p>
                <% } else { %>
                    <div class="summary-grid">
                        <div class="summary-card">
                            <h3>Total Sales</h3>
                            <div class="value">₱<%= summary.totalSales.toFixed(2) %></div>
                        </div>
                        <div class="summary-card">
                            <h3>Total Orders</h3>
                            <div class="value"><%= summary.totalOrders %></div>
                        </div>
                        <div class="summary-card">
                            <h3>Average Order Value</h3>
                            <div class="value">₱<%= summary.averageOrderValue.toFixed(2) %></div>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Daily Sales Table -->
            <div class="report-section">
                        <h2>Daily Sales Table</h2>
                <% if (dailySales.length === 0) { %>
                    <p class="no-data-message">No daily sales to display.</p>
                <% } else { %>
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Total Sales</th>
                                <th>Number of Orders</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% dailySales.forEach(function(day) { %>
                                <tr>
                                    <td><%= day.date %></td>
                                    <td>₱<%= Number(day.totalSales).toFixed(2) %></td>
                                    <td><%= day.orderCount %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>

            <!-- Sales Chart -->
            <div class="report-section">
                        <h2>Sales Chart</h2>
                <% if (dailySales.length === 0) { %>
                    <p class="no-data-message">No sales data to chart for the selected filters.</p>
                <% } else { %>
                    <div class="chart-container">
                        <canvas id="salesChart"></canvas>
                    </div>
                    <script>
                        // Get data from server-side variables
                        const salesLabels = <%- JSON.stringify(labels) %>;
                        const salesValues = <%- JSON.stringify(salesData) %>;
                        
                        const ctx = document.getElementById("salesChart").getContext("2d");
                        new Chart(ctx, {
                            type: "bar",
                            data: {
                                labels: salesLabels,
                                datasets: [
                                    {
                                        label: "Total Sales per Day (₱)",
                                        data: salesValues,
                                        backgroundColor: "rgba(124, 179, 66, 0.6)",
                                        borderColor: "rgba(124, 179, 66, 1)",
                                        borderWidth: 2
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            callback: function(value) {
                                                return '₱' + value.toLocaleString();
                                            }
                                        }
                                    }
                                },
                                plugins: {
                                    legend: {
                                        display: true,
                                        position: 'top'
                                    }
                                }
                            }
                        });
                    </script>
                <% } %>
            </div>
        </div>
    </main>

    <!-- Footer -->
     <section class="no-print">
    <%- include('/partials/footer.ejs') %>
    </section>
</body>
</html>
