<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Success - Pixel Stop</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/products">Products</a></li>
                <li><a href="/contact">Contact</a></li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <li><a href="/users/dashboard">Dashboard</a></li>
                    <li><a href="/orders/my-orders">My Orders</a></li>
                    <li><a href="/users/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/users/login">Login</a></li>
                    <li><a href="/users/register">Register</a></li>
                <% } %>
            </ul>
        </div>
    </nav>

    <main>
        <section class="hero" style="background: linear-gradient(to bottom, var(--minecraft-green), var(--pastel-blue));">
            <h1>Order Placed Successfully!</h1>
            <p>Thank you for your purchase</p>
        </section>

        <section>
            <div class="container">
                <div class="pixel-box" style="max-width: 600px; margin: 2rem auto; text-align: center;">
                    <div style="font-size: 4rem; margin-bottom: 1rem;">✅</div>
                    <h2>Your order has been placed!</h2>
                    
                    <% if (typeof message !== 'undefined' && message) { %>
                        <p style="margin: 1.5rem 0;"><%= message %></p>
                    <% } %>
                    
                    <p style="margin: 1.5rem 0;">
                        We've received your order and will process it shortly. 
                        You can view your order status in your order history.
                    </p>
                    
                    <div style="display: flex; gap: 1rem; justify-content: center; margin-top: 2rem;">
                        <a href="/orders/my-orders" class="pixel-btn">View My Orders</a>
                        <a href="/products" class="pixel-btn">Continue Shopping</a>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <%- include('/partials/footer.ejs') %>
    
    <!-- Hidden user data for cart.js -->
    <div data-user-id="<%= typeof user !== 'undefined' && user ? user.userId : 'guest' %>" style="display: none;"></div>
    
    <script src="/js/cart.js"></script>
    <script>
        // Clear cart after successful order
        document.addEventListener('DOMContentLoaded', function() {
            // Clear the cart from localStorage
            cart = [];
            saveCart();
        });
    </script>
</body>
</html>
