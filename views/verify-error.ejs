<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verification Error - Pixel Stop</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .error-container {
            max-width: 600px;
            margin: 4rem auto;
            padding: 2rem;
            background-color: #ffffff;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
            text-align: center;
            border: 2px solid #e74c3c;
        }

        .error-title {
            color: #e74c3c;
            margin-bottom: 1rem;
            font-family: 'Press Start 2P', cursive;
        }

        .error-message {
            color: #333333;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .btn-register,
        .btn-home {
            background-color: #8e44ad;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 4px;
            font-family: 'Press Start 2P', cursive;
            display: inline-block;
            transition: all 0.3s ease;
            margin: 0.5rem;
        }

        .btn-register:hover,
        .btn-home:hover {
            background-color: #9b59b6;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .pixel-x {
            width: 100px;
            height: 100px;
            margin: 0 auto 2rem;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .pixel-x:before,
        .pixel-x:after {
            content: '';
            position: absolute;
            width: 10px;
            height: 100px;
            background-color: #e74c3c;
        }

        .pixel-x:before {
            transform: rotate(45deg);
        }

        .pixel-x:after {
            transform: rotate(-45deg);
        }
    </style>
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/products">Products</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/users/login">Login</a></li>
                <li><a href="/users/register">Register</a></li>
            </ul>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="error-container">
            <div class="pixel-x"></div>
            <h1 class="error-title"><%= errorType %></h1>
            <p class="error-message"><%= message %></p>
            <div>
                <a href="/" class="btn-home">RETURN TO HOME</a>
                <a href="/users/register" class="btn-register">REGISTER AGAIN</a>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include('/partials/footer.ejs') %>

</body>

</html>
