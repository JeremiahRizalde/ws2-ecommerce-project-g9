<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Link Sent - Pixel Stop</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .success-container {
            max-width: 600px;
            margin: 4rem auto;
            padding: 2rem;
            background-color: #ffffff;
            border-radius: 5px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
            text-align: center;
            border: 2px solid #8e44ad;
        }

        .success-title {
            color: #8e44ad;
            margin-bottom: 1rem;
            font-family: 'Press Start 2P', cursive;
        }

        .success-message {
            color: #333333;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .btn-home {
            background-color: #8e44ad;
            color: white;
            padding: 10px 20px;
            text-decoration: none;
            border-radius: 4px;
            font-family: 'Press Start 2P', cursive;
            display: inline-block;
            transition: all 0.3s ease;
        }

        .btn-home:hover {
            background-color: #9b59b6;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
        }

        .pixel-mail {
            width: 100px;
            height: 80px;
            margin: 0 auto 2rem;
            position: relative;
            border: 10px solid #8e44ad;
            border-top: none;
        }

        .pixel-mail:before {
            content: '';
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            border-left: 50px solid transparent;
            border-right: 50px solid transparent;
            border-top: 40px solid #8e44ad;
        }

        .pixel-mail:after {
            content: '';
            position: absolute;
            top: -10px;
            left: -10px;
            right: -10px;
            border-left: 50px solid transparent;
            border-right: 50px solid transparent;
            border-top: 40px solid #fff;
            transform: translateY(5px);
        }
    </style>
</head>

<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/products">Products</a></li>
                <li><a href="/contact">Contact</a></li>
                <li><a href="/users/login">Login</a></li>
                <li><a href="/users/register">Register</a></li>
            </ul>
        </div>
    </nav>

    <div class="container mt-5">
        <div class="success-container">
            <div class="pixel-mail"></div>
            <h1 class="success-title">CHECK YOUR EMAIL!</h1>
            <p class="success-message">If an account with that email exists, a password reset link has been sent to your inbox.</p>
            <p class="success-message">Please check your email and follow the instructions to reset your password. Don't forget to check your spam folder!</p>
            <a href="/" class="btn-home">RETURN TO HOME</a>
        </div>
    </div>

    <!-- Footer -->
    <%- include('/partials/footer.ejs') %>

</body>

</html>
