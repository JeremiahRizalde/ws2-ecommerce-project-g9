<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-site-verification" content="5spttXzwB0T3J_5gPbdLthzVnGTp2i-stA1wmBnRGtw" />
    <title>Home - Pixel Stop</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/cart.css">
    <style>
        .products-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }
        
        .product-card {
            border: 4px solid var(--pixel-black);
            background-color: white;
            position: relative;
            transition: transform 0.3s ease;
        }
                
        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 6px 6px 0 var(--minecraft-green);
        }
        
        .product-img {
            width: 100%;
            height: 200px;
            overflow: hidden;
            border-bottom: 4px solid var(--pixel-black);
        }
        
        .product-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        
        .product-info {
            padding: 1rem;
        }
        
        .product-info h3 {
            font-size: 1rem;
            margin-bottom: 0.5rem;
        }
        
        .product-description {
            font-size: 0.75rem;
            margin-bottom: 1rem;
            color: var(--text-secondary);
        }
        
        .product-price {
            font-size: 1.25rem;
            margin-bottom: 1rem;
            color: var(--minecraft-green);
            font-weight: bold;
        }
        
        .add-to-cart {
            width: 100%;
        }
    </style>
</head>
<body>
    <!-- Hidden user data for cart.js -->
    <div data-user-id="<%= typeof user !== 'undefined' && user ? user.userId : 'guest' %>" style="display: none;"></div>
    
    <nav class="navbar">
        <div class="container nav-container">
            <div class="logo">
                <img src="/images/logo.png" alt="Pixel Stop Logo" onerror="this.src='/images/placeholder.png'">
                <span>Pixel Stop</span>
            </div>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/about">About</a></li>
                <li><a href="/products">Products</a></li>
                <li><a href="/contact">Contact</a></li>
                <% if (typeof user !== 'undefined' && user) { %>
                    <li><a href="/users/dashboard">Dashboard</a></li>
                    <li><a href="/users/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/users/login">Login</a></li>
                    <li><a href="/users/register">Register</a></li>
                <% } %>
                <li>
                    <a href="/cart" class="cart-icon">
                        <img src="/images/cart-icon.svg" alt="Cart">
                    <span id="cart-count">0</span>

                    </a>
                </li>
            </ul>
        </div>
    </nav>

    <!-- Flash Messages -->
    <% if (typeof message !== 'undefined' && message && message.length > 0) { %>
        <div class="container">
            <div class="alert alert-success">
                <%= message %>
            </div>
        </div>
    <% } %>
    
    <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
        <div class="container">
            <div class="alert alert-danger">
                <%= error %>
            </div>
        </div>
    <% } %>

    <!-- Main Content -->
    <main>
        <section class="hero" style="background: linear-gradient(to bottom, var(--pastel-purple), var(--pastel-blue));">
            <h1>Pixel Stop</h1>
            <p>Your one-stop shop for merchandise from your favorite chill games!</p>
            <div style="margin-top: 2rem;">
                <a href="/products" class="pixel-btn">Shop Now</a>
            </div>
        </section>

        <section>
            <div class="container">
                <h2 style="text-align: center; margin: 2rem 0;">Featured Games</h2>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 2rem; margin-bottom: 3rem;">
                    <!-- Minecraft -->
                    <div class="pixel-box">
                        <img src="https://thumbs.dreamstime.com/b/minecraft-editorial-vector-illustration-minecraft-editorial-vector-illustration-white-background-136940621.jpg" alt="Minecraft" style="width: 100%; image-rendering: pixelated;">
                        <h3>Minecraft</h3>
                        <p>Build, explore, and survive in a blocky world of adventure!</p>
                        <a href="/products/minecraft" class="pixel-btn">Shop Minecraft</a>
                    </div>
                    
                    <!-- Stardew Valley -->
                    <div class="pixel-box">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcS0hIZGAS7Nyse0f3Q4n-Y9-dBobS-RldpGFg&s" alt="Stardew Valley" style="width: 100%; image-rendering: pixelated;">
                        <h3></h3>
                        <h3>Stardew Valley</h3>
                        <p>Farm, fish, and make friends in a cozy countryside community!</p>
                        <a href="/products/stardewvalley" class="pixel-btn">Shop Stardew Valley</a>
                    </div>
                    
                    <!-- Terraria -->
                    <div class="pixel-box">
                        <img src="https://i.pinimg.com/736x/ed/3b/ac/ed3bac1a66b62f54a6d4a90f28fe6ee7.jpg" alt="Terraria" style="width: 100%; image-rendering: pixelated;">
                        <h3>Terraria</h3>
                        <p>Dig, fight, and build in this 2D adventure sandbox!</p>
                        <a href="/products/terraria" class="pixel-btn">Shop Terraria</a>
                    </div>
                    
                    <!-- Pokemon -->
                    <div class="pixel-box">
                        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTvI9U-ImGqO7fh6lVypwxZCbx0xSa-qLV_LA&s" alt="Pokemon" style="width: 100%; image-rendering: pixelated;">
                        <h3>Pokemon</h3>
                        <p>Catch, train, and battle with your favorite pocket monsters!</p>
                        <a href="/products/pokemon" class="pixel-btn">Shop Pokemon</a>
                    </div>
                </div>
            </div>
        </section>

        <section style="background-color: rgba(0, 255, 208, 0.17); padding: 3rem 0;">
            <div class="container">
                <h2 style="text-align: center; margin-bottom: 2rem;">Featured Products</h2>
                <div class="products-grid">
                    <% if (typeof featuredProducts !== 'undefined' && featuredProducts.length > 0) { %>
                        <% featuredProducts.forEach(product => { %>
                            <div class="product-card" data-product-id="<%= product._id %>">
                                <div class="product-img">
                                    <img src="<%= product.imageUrl %>" alt="<%= product.title %>" onerror="this.src='/images/placeholder.png'">
                                </div>
                                <div class="product-info">
                                    <h3><%= product.title %></h3>
                                    <p class="product-description"><%= product.description %></p>
                                    <p class="product-price">₱<%= product.price.toFixed(2) %></p>
                                    <button class="pixel-btn add-to-cart">Add to Cart</button>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div style="grid-column: 1 / -1; text-align: center; padding: 3rem;">
                            <p style="font-size: 1rem; margin-bottom: 1rem;">No featured products available yet.</p>
                            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                                <a href="/admin/products" class="pixel-btn">Add Products</a>
                            <% } %>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <section style="padding: 3rem 0;">
            <div class="container">
                <div class="pixel-box" style="text-align: center; padding: 2rem;">
                    <h2>Join Our Community</h2>
                    <p style="max-width: 600px; margin: 1rem auto;">Sign up for our newsletter to receive updates on new merchandise, sales, and exclusive content from your favorite games!</p>
                    <form style="max-width: 500px; margin: 0 auto;">
                        <div style="display: flex; gap: 1rem;">
                            <input type="email" placeholder="Your email address" style="flex: 1;">
                            <button type="submit" class="pixel-btn">Subscribe</button>
                        </div>
                    </form>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
         <%- include('/partials/footer.ejs') %>
    
    <script src="/js/cart.js"></script>
</body>
</html>